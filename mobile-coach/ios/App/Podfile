if File.exist?('../../node_modules/@capacitor/ios/scripts/pods_helpers.rb')
  require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'
elsif File.exist?('../../../node_modules/@capacitor/ios/scripts/pods_helpers.rb')
  require_relative '../../../node_modules/@capacitor/ios/scripts/pods_helpers'
end

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  cap_path = File.exist?('../../node_modules/@capacitor/ios') ? '../../node_modules/@capacitor/ios' : '../../../node_modules/@capacitor/ios'
  pod 'Capacitor', :path => cap_path
  pod 'CapacitorCordova', :path => cap_path
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
