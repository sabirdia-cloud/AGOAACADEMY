{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:admin": "VITE_APP_MODE=ADMIN vite build --outDir dist-admin",
    "build:coach": "VITE_APP_MODE=COACH vite build --outDir dist-coach",
    "build:parent": "VITE_APP_MODE=PARENT vite build --outDir dist-parent",
    "build:registration": "VITE_APP_MODE=REGISTRATION vite build --outDir dist-registration",
    "build:register": "vite build --config vite.register.config.ts",
    "build:all": "npm run build:admin && npm run build:coach && npm run build:parent && npm run build:registration && npm run build:register",
    "build:win": "vite build && electron-builder --win",
    "electron:start": "electron .",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:coaches-mobile": "vite build --config vite.coaches.config.ts",
    "cap:sync:coaches": "npm run build:coaches-mobile && cd mobile-coach && npx cap sync",
    "cap:open:coaches:android": "cd mobile-coach && npx cap open android",
    "cap:open:coaches:ios": "cd mobile-coach && npx cap open ios",
    "dev:coaches-mobile": "vite --config vite.coaches.config.ts --host",
    "cap:sync:coach": "npm run build:coach && cd mobile-coach && npx cap sync",
    "cap:sync:parent": "npm run build:parent && cd mobile-parent && npx cap sync",
    "cap:open:coach:android": "cd mobile-coach && npx cap open android",
    "cap:open:coach:ios": "cd mobile-coach && npx cap open ios",
    "cap:open:parent:android": "cd mobile-parent && npx cap open android",
    "cap:open:parent:ios": "cd mobile-parent && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "algeria-locations": "^1.0.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.21",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.academy.app",
    "productName": "Academy Manager",
    "directories": {
      "output": "release/"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
